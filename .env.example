# SQL Server connection parameters
# Copy this file to .env and fill in your actual values,
# or run: griphook configure

SQL_SERVER=your-server.database.windows.net
SQL_PORT=1433
SQL_DATABASE=your_database_name
SQL_USER=your_username
SQL_PASSWORD=your_password
SQL_TRUST_CERT=true

# Authentication mode: "sql" (default, uses SQL_USER/SQL_PASSWORD)
# or "windows" (Integrated/Trusted connection — Windows only, ignores user/password)
SQL_AUTH=sql

# ODBC driver name. Auto-detected when omitted (prefers 18, falls back to 17).
# SQL_DRIVER=ODBC Driver 18 for SQL Server
